        <artifactId>backforge-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../backforge-parent/pom.xml</relativePath>
    </parent>
    <artifactId>backforge-example</artifactId>
    <name>Backforge Example</name>

    <dependencies>
        <dependency>
            <groupId>io.backforge</groupId>
            <artifactId>backforge-data</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
